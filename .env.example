# Neon Postgres connection string from https://console.neon.tech
# Project: mccicts (rapid-sunset-95667679)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Local API port (optional)
API_PORT=3456

# Administrator login password (change in production)
ADMIN_PASSWORD=142536

# Secret used to sign stateless session tokens. Use a long random string.
# REQUIRED in production (e.g. on Vercel) so tokens stay valid across requests.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Session lifetime in hours
SESSION_HOURS=24

# Neon project reference (optional, for documentation)
NEON_PROJECT_ID=rapid-sunset-95667679
